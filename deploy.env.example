# Copy to deploy.env (not committed) and adjust. Used by scripts/deploy.sh
# and scripts/coredump.sh.
HOST=root@192.168.1.50        # SSH target of the station
SSH_PORT=22
SSH_KEY=                      # optional: path to the private key
APP=alisa-panel               # install name: /data/opt/bin/$APP, /etc/init.d/S98$APP, /data/opt/etc/$APP
ZIG_FLAGS=                    # extra flags for zig build, e.g. --zig-lib-dir /path/to/lib
