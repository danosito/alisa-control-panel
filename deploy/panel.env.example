# Panel configuration, sourced by panel-supervise: /data/opt/etc/<APP>/panel.env
# POSIX sh syntax (KEY=value, quote values with spaces). Apply: /etc/init.d/S98<APP> restart

# Name shown in the UI and in passkey prompts.
PANEL_NAME="Станция"

# Sign-in: passwords and passkeys in any mix. The first visit sets up access;
# more devices are added in the UI ("Устройства и входы" -> pairing code).
# Anyone who logs in gets a root shell (terminal widget).

# --- Simplest setup: plain HTTP in the LAN -----------------------------------
PANEL_TLS=off
PANEL_PORT=8080
# Optional fallback password (at least 8 characters), always accepted.
# PANEL_PASSWORD=

# --- HTTPS, passkeys too (needs a domain pointing at the station and a cert) --
# PANEL_TLS=on                 # or auto: on when the files below exist
# PANEL_PORT=443
# PANEL_TLS_CERT=/data/opt/etc/alisa-panel/tls/fullchain.pem
# PANEL_TLS_KEY=/data/opt/etc/alisa-panel/tls/privkey.pem
# PANEL_ORIGIN=https://panel.example.com   # passkeys work only on this address
# PANEL_RP_ID=panel.example.com   # defaults to the ORIGIN host
# PANEL_AUTH=password             # turn passkeys off

# PANEL_BIND=0.0.0.0
